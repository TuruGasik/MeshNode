###############################################################################
# MeshNode stack configuration - CONTOH. Copy ke .env lalu isi nilai riil:
#   cp .env.example .env
#
# .env dibaca docker-compose.yml (interpolasi ${VAR}) dan script monitoring host.
#
# ATURAN
# - Nilai .env TIDAK bisa mereferensi nilai .env lain; secret lintas service
#   di-wire di docker-compose.yml (mis. MQTT_PASSWORD=${EMQX_USER_MESHMAP_PASS}).
# - Password MQTT ada di section 3 (broker pemilik identitas), lalu
#   direferensikan oleh service meshmap/relay/autonotif via compose.
# - emqx/acl.conf mereferensi username secara literal - sinkronkan manual
#   kalau mengganti username.
# - Password/username JANGAN mengandung ',' (bootstrap file = CSV).
# - Kalau nilai mengandung '$' literal, tulis '$$' (escape interpolasi compose).
#
# CAVEAT OPERASIONAL
# 1. Bootstrap EMQX hanya MENAMBAH user baru, tidak meng-update. CSV hanya
#    menambah username yang belum ada di built-in DB (volume emqx-data).
#    Rotasi password user MQTT yang sudah ada: edit .env + restart service
#    terkait + update user via dashboard (https://127.0.0.1:18084) atau REST
#    API - ATAU wipe volume emqx-data (kehilangan retained msg/session/user
#    dashboard) untuk memaksa re-bootstrap penuh.
# 2. EMQX_DASHBOARD_ADMIN_PASS hanya berlaku saat first boot volume baru.
# 3. Debug autonotif di host: AUTONOTIF_MQTT_PASS tidak ada lagi di .env,
#    jalankan: AUTONOTIF_MQTT_PASS=<EMQX_USER_BMKGGEMPA_PASS> ./autonotif
###############################################################################

# ============================== 1. meshmap ===================================
MESHMAP_MQTT_BROKER=tcp://meshnode-mqtt:1883
MESHMAP_MQTT_USERNAME=meshmap
# password: EMQX_USER_MESHMAP_PASS (section 3)
MESHMAP_MQTT_TLS_SERVER_NAME=example.com        # dipakai hanya jika broker ssl://
MESHMAP_TRACKER_PASSWORD=change-me

# ============================== 2. autonotif =================================
AUTONOTIF_MQTT_HOST=meshnode-mqtt
AUTONOTIF_MQTT_PORT=1883
AUTONOTIF_MQTT_TLS=false
AUTONOTIF_MQTT_TLS_SERVER_NAME=
AUTONOTIF_MQTT_USER=BMKGGempa
# password: EMQX_USER_BMKGGEMPA_PASS (section 3)
AUTONOTIF_MQTT_CLIENT_ID=MeshNode-WRS
AUTONOTIF_LOG_LEVEL=info
# --- Identitas Meshtastic / crypto ---
AUTONOTIF_MESHTASTIC_TOPIC_ROOT=msh/ID/2/e
AUTONOTIF_MESHTASTIC_CHANNEL=GempaBumi
AUTONOTIF_MESHTASTIC_PRIVATE_KEY=GA==
AUTONOTIF_MESHTASTIC_PKI_KEY_FILE=/data/meshtastic-pki.key
AUTONOTIF_MESHTASTIC_NODE_KEYS_FILE=/data/meshtastic-nodekeys.json
AUTONOTIF_MESHTASTIC_FROM_NODE=0x77727342
AUTONOTIF_MESHTASTIC_HOP_LIMIT=3
AUTONOTIF_MESHTASTIC_LONG_NAME=MeshNode WRS
AUTONOTIF_MESHTASTIC_SHORT_NAME=-GB-
AUTONOTIF_MESHTASTIC_HW_MODEL=255
AUTONOTIF_MESHTASTIC_ROLE=0
AUTONOTIF_NODE_INFO_INTERVAL=3h
# --- Polling gempa BMKG ---
AUTONOTIF_BMKG_SOURCE=inatews2
AUTONOTIF_BMKG_URL=https://data.bmkg.go.id/DataMKG/TEWS/autogempa.json
AUTONOTIF_BMKG_INATEWS2_URL=https://bmkg-content-inatews.storage.googleapis.com/live30event.xml
AUTONOTIF_POLL_INTERVAL=2s
AUTONOTIF_MIN_MAGNITUDE=4.0
AUTONOTIF_STATE_FILE=/data/autonotif-bmkg-inatews2-state.json
# --- Bot responder ---
AUTONOTIF_BOT_ENABLE_RESPONDER=true
AUTONOTIF_BOT_REPLY_TO_DM=true
AUTONOTIF_BOT_ADMIN_NODES=0xaf1e4204
AUTONOTIF_BOT_CONFIG_FILE=/data/autonotif-bot-config.json
# --- Hantavirus tracker ---
AUTONOTIF_HANTAVIRUS_DB_PATH=/data/autonotif.db
AUTONOTIF_HANTAVIRUS_RAILWAY_URL=
# --- Debug one-shot: biarkan komentar untuk stack long-running ---
#AUTONOTIF_ONCE=true
#AUTONOTIF_DRY_RUN=true
#AUTONOTIF_SEND_ON_START=true
#AUTONOTIF_HANTAVIRUS_ONCE=true
#AUTONOTIF_MESSAGE=
#AUTONOTIF_MESHTASTIC_PKI_PRIVATE_KEY=

# ============================== 3. emqx broker ===============================
EMQX_LICENSE_KEY=your-emqx-license-key
EMQX_NODE_COOKIE=choose-a-random-cookie
EMQX_LOG_LEVEL=info
# Password dashboard hanya berlaku saat FIRST BOOT volume emqx-data baru:
#EMQX_DASHBOARD_ADMIN_PASS=change-me
# Password user MQTT (single source of truth; CSV bootstrap digenerate
# dari sini tiap start).
EMQX_USER_MESHMAP_PASS=change-me
EMQX_USER_RELAY_PASS=change-me
EMQX_USER_BMKGGEMPA_PASS=change-me
EMQX_USER_IDMESHNODE_NAME=idmeshnode
EMQX_USER_IDMESHNODE_PASS=change-me
EMQX_USER_KEMPLU_NAME=kemplu
EMQX_USER_KEMPLU_PASS=change-me

# ============================== 4. mqtt-relay ================================
RELAY_LOCAL_MQTT_HOST=meshnode-mqtt
RELAY_LOCAL_MQTT_PORT=1883
RELAY_LOCAL_MQTT_TLS=false
RELAY_LOCAL_MQTT_TLS_SERVER_NAME=
RELAY_LOCAL_MQTT_USERNAME=mqtt-relay
# password: EMQX_USER_RELAY_PASS (section 3)
RELAY_UPSTREAM_A_HOST=mqtt4.meshnode.id
RELAY_UPSTREAM_A_PORT=1883
RELAY_UPSTREAM_A_USERNAME=idmeshnode
RELAY_UPSTREAM_A_PASSWORD=your-upstream-a-password
RELAY_UPSTREAM_A_TLS=false
RELAY_UPSTREAM_A_TLS_SERVER_NAME=
RELAY_UPSTREAM_B_HOST=mqtt.meshtastic.org
RELAY_UPSTREAM_B_PORT=1883
RELAY_UPSTREAM_B_USERNAME=meshdev
RELAY_UPSTREAM_B_PASSWORD=large4cats
RELAY_UPSTREAM_B_TLS=false
RELAY_UPSTREAM_B_TLS_SERVER_NAME=
RELAY_TOPIC_ROOT=msh/ID/#
RELAY_DEDUP_TTL=600
RELAY_CLEANUP_INTERVAL=60
RELAY_STATS_INTERVAL=60
RELAY_PUBLISH_QOS=0
RELAY_SUBSCRIBE_QOS=0
RELAY_PUBLISH_TIMEOUT_MS=5000
RELAY_HEALTH_PORT=8081
RELAY_SHUTDOWN_TIMEOUT_MS=5000
RELAY_LOG_LEVEL=INFO

# ================= 5. script monitoring host (scripts/*.py) ==================
MONITOR_GEMPA_HOST=tcp://meshnode-mqtt
MONITOR_GEMPA_PORT=1883
MONITOR_GEMPA_USER=idmeshnode
MONITOR_GEMPA_PASS=change-me
# monitor_gempabumi.py baca nama unprefixed ini; samakan dengan section 2:
MESHTASTIC_CHANNEL=GempaBumi
MESHTASTIC_PRIVATE_KEY=GA==
#MONITOR_LOCAL_HOST=localhost
#RELAY_METRICS_URL=http://localhost:8081/metrics
# PSK base64 per-channel — dipakai monitor_mqtt_relay.py dan
# monitor_messages.py untuk decrypt tampilan (relay tidak pernah decrypt):
PRIVATE_CHANNEL_PSK=
MESHNODE_ID_CHANNEL_PSK=
