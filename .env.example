MQTT_BROKER=tcp://meshnode-mqtt:1883
MQTT_USERNAME=your-mqtt-username
MQTT_PASSWORD=your-mqtt-password
EMQX_LICENSE_KEY=your-emqx-enterprise-license-key
LOCAL_MQTT_HOST=meshnode-mqtt
LOCAL_MQTT_PORT=1883
LOCAL_MQTT_TLS=false
LOCAL_MQTT_USERNAME=mqtt-relay
LOCAL_MQTT_PASSWORD=your-relay-dedup-password
UPSTREAM_A_HOST=mqtt.meshnode.id
UPSTREAM_A_PORT=1883
UPSTREAM_A_USERNAME=your-upstream-a-username
UPSTREAM_A_PASSWORD=your-upstream-a-password
UPSTREAM_B_HOST=mqtt.meshtastic.org
UPSTREAM_B_PORT=1883
UPSTREAM_B_USERNAME=your-upstream-b-username
UPSTREAM_B_PASSWORD=your-upstream-b-password
TOPIC_ROOT=msh/ID/#
DEDUP_TTL=600
CLEANUP_INTERVAL=60
RELAY_LOG_LEVEL=INFO
TLS_DOMAIN=your-domain.example.com
